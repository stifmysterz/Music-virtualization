{
  "name": "sub-remix",
  "productName": "SUB REMIX",
  "version": "1.1.4",
  "description": "SUB REMIX — Music Visualizer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "playwright test",
    "verify:replacement": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/verify-replacement.ps1",
    "verify:replace-zip": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/verify-replace-zip.ps1",
    "build:replace-zip": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/generate-replace.ps1",
    "verify:version": "node scripts/verify-version.js",
    "verify:mode-quality": "node scripts/sync-mode-quality.js",
    "sync:mode-quality": "node scripts/sync-mode-quality.js --write",
    "verify:music-state": "node scripts/sync-music-state.js",
    "sync:music-state": "node scripts/sync-music-state.js --write",
    "verify:scene-cache": "node scripts/sync-scene-cache.js",
    "sync:scene-cache": "node scripts/sync-scene-cache.js --write",
    "verify:vj-registry": "node scripts/sync-vj-registry.js",
    "sync:vj-registry": "node scripts/sync-vj-registry.js --write",
    "verify:bg3d-catalog": "node scripts/sync-bg3d-catalog.js",
    "sync:bg3d-catalog": "node scripts/sync-bg3d-catalog.js --write",
    "verify:vj-loop-contract": "node scripts/sync-vj-loop-contract.js",
    "sync:vj-loop-contract": "node scripts/sync-vj-loop-contract.js --write",
    "verify:release": "node scripts/release-integrity.js verify",
    "release:manifest": "node scripts/release-integrity.js generate",
    "release": "node scripts/release.js",
    "predist": "npm run verify:version && npm run verify:mode-quality && npm run verify:music-state && npm run verify:scene-cache && npm run verify:vj-registry && npm run verify:bg3d-catalog && npm run verify:vj-loop-contract && npm run verify:replacement",
    "dist": "electron-builder --win",
    "postinstall": "patch-package",
    "icon": "node scripts/build-icon.js"
  },
  "keywords": [],
  "author": "stifmysterz",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "patch-package": "^8.0.1"
  },
  "build": {
    "appId": "com.subremix.visualizer",
    "productName": "SUB REMIX",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../61.html",
        "to": "app/61.html"
      },
      {
        "from": "../fonts",
        "to": "app/fonts"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
